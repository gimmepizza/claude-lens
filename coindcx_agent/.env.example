# ── CoinDCX API (only needed for `balance` and `live`) ─────────────
# Create keys at https://coindcx.com/api-dashboard. Do NOT enable withdrawals on the key.
COINDCX_API_KEY=
COINDCX_API_SECRET=

# Live trading stays locked unless this is set exactly:
# LIVE_TRADING_CONFIRM=I_ACCEPT_THE_RISK

# ── Market & strategy ─────────────────────────────────────────────
TRADING_MARKET=BTCINR
STRATEGY=ensemble
# CANDLE_INTERVAL=         # blank = strategy default (1h swing, 15m intraday)

# ── Costs (check your CoinDCX fee tier!) ──────────────────────────
FEE_PCT=0.5
GST_ON_FEE_PCT=18
SPREAD_PCT=0.3
SLIPPAGE_PCT=0.05
MAKER_ENTRIES=false         # enter with resting bids instead of crossing the spread
MAKER_FEE_PCT=0.5
TDS_PCT=1.0
TAX_RATE_PCT=31.2

# ── Risk ──────────────────────────────────────────────────────────
CAPITAL_LIMIT=5000          # live: max quote currency the bot may use
MAX_ORDER_VALUE=10000       # cap on any single order
MAX_POSITION_PCT=100        # max % of bot equity in the asset
# STOP_ATR_MULT=0           # protective stop in ATRs (swing default 0 = off; intraday 2)
# STOP_ATR_SOURCE=daily     # daily | bar (ATR of the trading candles)
# TAKE_PROFIT_ATR_MULT=0
# MIN_HOLD_HOURS=0          # intraday strategies default to 0.5
# MAX_HOLD_HOURS=0          # intraday strategies default to 3 (time exit)
RISK_PER_TRADE_PCT=1.0      # only used when a stop is set
DAILY_LOSS_LIMIT_PCT=3
MAX_DRAWDOWN_PCT=35         # kill switch: flatten and halt

# ── Paper / storage ───────────────────────────────────────────────
PAPER_CASH=100000
STATE_DB=coindcx_state.sqlite
DATA_DIR=data
